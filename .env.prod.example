# SEO Analyzer - Production Environment Configuration
# Copy this file to .env.prod and fill in the actual values

# Database
DATABASE_URL=your_database_url_here

# Redis
REDIS_URL=redis://redis:6379/0

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=your_allowed_hosts_here

# API Keys
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here
GEMINI_API_KEY=your_gemini_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here
SERPAPI_KEY=your_serpapi_key_here
PAGESPEED_API_KEY=your_pagespeed_key_here

# CORS and Security
CORS_ORIGINS=https://129.148.63.199,https://iqui27.app
SECURE_COOKIES=true
SESSION_TIMEOUT=3600

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=300
MAX_CONCURRENT_RUNS=5
ENABLE_METRICS=true

# Database Connection
DB_CONNECT_TIMEOUT=60
DB_COMMAND_TIMEOUT=120